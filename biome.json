{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveNestedTestSuites": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDuplicateTestHooks": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": {
            "requireExplicitCase": true
          }
        },
        "noExcessiveNestedBlocks": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "style": {
        "noUselessElse": "error",
        "noDoneCallback": "error",
        "noParameterAssign": {
          "level": "error",
          "options": {
            "propertyAssignment": "allow"
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "livekit-server-sdk",
                      "**/examples/**",
                      "**/scripts/**"
                    ],
                    "message": "Token issuance and server operations belong in backend examples, outside the browser application."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/phone-orientation.ts",
        "src/livekit-url.ts",
        "src/errors.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**"],
                    "message": "These transformations accept data and must not import live adapters."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Keep network operations in adapters.",
                  "WebSocket": "Keep live connections in adapters.",
                  "navigator": "Pass device observations into transformations.",
                  "document": "Keep DOM operations in the UI.",
                  "window": "Pass browser observations into transformations."
                }
              }
            }
          }
        }
      }
    }
  ]
}
