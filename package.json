{
  "name": "@hebbian/browser-camera",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source browser camera streaming and a multi-camera room viewer for LiveKit.",
  "homepage": "https://hebbian-robotics.github.io/livekit-cameras/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hebbian-Robotics/livekit-cameras.git"
  },
  "keywords": [
    "livekit",
    "webrtc",
    "camera-streaming",
    "browser-camera",
    "usb-camera",
    "robotics"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && tsx scripts/write-browser-licenses.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "invite": "tsx examples/create-invite.ts",
    "viewer-invite": "tsx examples/create-viewer-invite.ts",
    "check": "pnpm lint && pnpm typecheck",
    "cargo:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "cargo:fmt": "cargo fmt --all --check",
    "check:native": "pnpm cargo:fmt && pnpm cargo:clippy",
    "check:all": "pnpm check && pnpm check:native"
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "jose": "6.2.17",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "livekit-server-sdk": "^2.19.3",
    "qrcode": "^1.5.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
