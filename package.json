{
  "name": "@hebbian/browser-camera",
  "version": "0.1.0",
  "private": true,
  "description": "Stream a browser camera to any LiveKit room.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && tsx scripts/write-browser-licenses.ts",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "invite": "tsx examples/create-invite.ts"
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "jose": "6.2.15",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "livekit-server-sdk": "^2",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.6"
  }
}
